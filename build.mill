package build

import mill._
import mill.scalalib._

object goldilocksNtt extends SbtModule {
  def scalaVersion = "2.13.18"
  def chiselVersion = "7.13.0"
  def repoDir = super.moduleDir / os.up
  def moduleDir = repoDir / "operators" / "goldilocks-ntt"
  override def sources = Task.Sources(
    moduleDir / "src" / "main" / "scala",
    repoDir / "common" / "goldilocks" / "src" / "main" / "scala",
  )
  override def scalacOptions = Seq(
    "-language:reflectiveCalls", "-deprecation", "-feature",
    "-Xcheckinit", "-Ymacro-annotations",
  )
  override def mvnDeps = Seq(mvn"org.chipsalliance::chisel:$chiselVersion")
  override def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:$chiselVersion",
  )
  object tool extends ScalaModule {
    def scalaVersion = goldilocksNtt.scalaVersion
    def moduleDir = goldilocksNtt.moduleDir
    override def sources = Task.Sources(moduleDir / "src" / "tool" / "scala")
    def moduleDeps = Seq(goldilocksNtt)
  }
}
